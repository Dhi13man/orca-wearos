{
  "name": "orca-wearos",
  "version": "0.0.1",
  "private": true,
  "main": "./index.ts",
  "scripts": {
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
