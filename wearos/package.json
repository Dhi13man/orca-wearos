    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@orca/expo-wear-data-layer": "workspace:*",
    "expo": "58.0.0-preview.7",
    "expo-build-properties": "58.0.7",
    "expo-crypto": "58.0.2",
    "expo-modules-core": "58.0.7",
    "expo-secure-store": "58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "expo": "58.0.0-preview.7",
      "react-native": "0.88.0-rc.1"
    }
  }
